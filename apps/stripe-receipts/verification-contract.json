      "assertion": {
        "all_of": [
          {
            "select": "status",
            "equals": "paid",
            "required": true
          },
          {
            "select": "amount_cents",
            "equals": 2000,
            "required": true
          },
          {
            "select": "receipt_status",
            "equals": "sent",
            "required": true
          },
          {
            "select": "receipt_ids[*]",
            "count": 1,
            "required": true
          }
        ]
      },
      "observation_deadline_seconds": 20
    },
    {
      "id": "concurrent_redelivery",
      "name": "Two overlapping first deliveries produce one receipt",
      "actions": [
        {
          "method": "POST",
          "path": "/orders",
          "body": {
            "sku": "mug",
            "quantity": 1,
            "customer_email": "buyer@example.test"
          }
        },
        {
          "method": "POST",
          "path": "/orders/{{step1.id}}/pay",
          "expect_status": 200
        },
        {
          "method": "GET",
          "path": "/orders/{{step1.id}}/payment-events"
        },
        {
          "provider_control": {
            "provider": "stripe",
            "scenario": "default"
          }
        },
        {
          "event": {
            "provider": "stripe",
            "replay_of": "{{step3.events.0.id}}"
          },
          "concurrency": 3
        }
      ],
      "before": {
        "path": "/orders",
        "assertion": {
          "select": "orders[*]",
          "count": 3,
          "required": true
        }
      },
      "observe": {
        "path": "/orders/{{step1.id}}"
      },
      "assertion": {
        "all_of": [
          {
            "select": "status",
            "equals": "paid",
            "required": true
          },
          {
            "select": "amount_cents",
            "equals": 1000,
            "required": true
          },
          {
            "select": "receipt_status",
            "equals": "sent",
            "required": true
          },
          {
            "select": "receipt_ids[*]",
            "count": 1,
            "required": true
          }
        ]
      },
      "observation_deadline_seconds": 20,
      "fault": {
        "provider": "stripe",
        "scenario": "webhook_withheld",
        "evidence": "webhook_withheld"
      }
    },
