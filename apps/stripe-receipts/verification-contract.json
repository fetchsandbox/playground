    {
      "id": "stale_or_reordered_event",
      "name": "A genuine earlier failure cannot undo a later completed payment",
      "actions": [
        {
          "method": "POST",
          "path": "/orders",
          "body": {
            "sku": "mug",
            "quantity": 1,
            "customer_email": "buyer@example.test"
