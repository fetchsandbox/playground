{
  "app_version": "stripe-receipts-durable-candidate-v1",
  "disposable_test_app": true,
  "require_verifier_token": true,
  "event_delivery": "provider_lifecycle",
  "event_destinations": {
    "stripe": "/stripe-webhook"
  },
  "observation_seconds": 0.1,
  "checks": [
    {
      "id": "baseline",
      "name": "Create one pending order from an empty ledger",
      "actions": [
        {
          "method": "POST",
          "path": "/orders",
          "body": {
            "sku": "mug",
            "quantity": 1,
            "customer_email": "buyer@example.test"
          }
        }
      ],
      "before": {
        "path": "/orders",
        "assertion": {
          "select": "orders[*]",
          "count": 0,
          "required": true
        }
      },
      "observe": {
        "path": "/orders"
      },
      "assertion": {
        "select": "orders[*]",
        "required": true,
        "count": 1
      },
      "observation_deadline_seconds": 20
    },
    {
      "id": "purchase_a",
      "name": "A payment produces one saved receipt",
      "actions": [
        {
          "method": "POST",
          "path": "/orders",
          "body": {
            "sku": "mug",
            "quantity": 1,
            "customer_email": "buyer@example.test"
          }
        },
        {
          "method": "POST",
          "path": "/orders/{{step1.id}}/pay",
          "expect_status": 200
        }
      ],
      "before": {
        "path": "/orders",
        "assertion": {
          "select": "orders[*]",
          "count": 1,
          "required": true
        }
      },
      "observe": {
        "path": "/orders/{{step1.id}}"
      },
      "assertion": {
        "all_of": [
          {
            "select": "status",
            "equals": "paid",
            "required": true
          },
          {
            "select": "amount_cents",
            "equals": 1000,
            "required": true
          },
          {
            "select": "receipt_status",
            "equals": "sent",
            "required": true
          },
          {
            "select": "receipt_ids[*]",
            "count": 1,
            "required": true
          }
        ]
      },
      "observation_deadline_seconds": 20
    },
    {
      "id": "purchase_b",
      "name": "A distinct payment produces its own receipt",
      "actions": [
        {
          "method": "POST",
          "path": "/orders",
          "body": {
            "sku": "mug",
