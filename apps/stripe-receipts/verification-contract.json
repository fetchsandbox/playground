      "observe": {
        "path": "/orders/{{step1.id}}"
      },
      "assertion": {
        "all_of": [
          {
            "select": "status",
            "equals": "paid",
            "required": true
          },
          {
            "select": "amount_cents",
            "equals": 1000,
            "required": true
          },
          {
            "select": "receipt_status",
            "equals": "sent",
            "required": true
          },
          {
            "select": "receipt_ids[*]",
