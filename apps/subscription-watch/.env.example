# Copy to .env and `set -a; source .env; set +a` before running locally.

# --- Google (Gmail + Calendar) ---
# Production: OAuth refresh token for the mailbox owner (scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/calendar.events)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Or a static access token (tests / sandboxes)
# GOOGLE_ACCESS_TOKEN=
# CALENDAR_ACCESS_TOKEN=     # only if Calendar needs a different token than Gmail

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=C0123456789     # channel ID; invite the bot to it

# --- Optional ---
# GMAIL_QUERY=in:inbox newer_than:2d
# CALENDAR_ID=primary
# RULES_PATH=rules.json
# SQLITE_PATH=subwatch.db
# PUSH_TOKEN=long-random-string   # required for /gmail/push
# GMAIL_BASE_URL / CALENDAR_BASE_URL / SLACK_BASE_URL  override provider hosts
