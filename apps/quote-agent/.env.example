# --- Claude intent classifier ---
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5-5
CLASSIFIER=auto                 # auto | claude | rules
CLASSIFIER_MIN_CONFIDENCE=0.6   # below this, the message goes to human triage

# --- Discount policy ---
DISCOUNT_APPROVAL_THRESHOLD_PCT=20   # >= this needs a manager
DISCOUNT_DECLINE_ABOVE_PCT=70        # > this is declined outright

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_DEAL_STAGE=presentationscheduled
HUBSPOT_RECORD_DEALS=true

# --- Pricing service (blank = in-process catalog) ---
PRICING_SERVICE_URL=

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_MANAGER_CHANNEL=           # channel id for approvals / declines / triage
SLACK_MANAGER_USER_IDS=          # comma-separated user ids allowed to approve
SLACK_INTAKE_CHANNELS=           # optional: channel ids where customer messages arrive (DMs always work)

# --- Gmail ---
GMAIL_ADDRESS=sales@example.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_PUSH_TOKEN=                # random string; also in the Pub/Sub push URL

# --- Misc ---
COMPANY_NAME=Northwind
QUOTE_VALID_DAYS=30
QUOTE_AGENT_DB=quote_agent.db
DEV_ENDPOINTS=false
QUOTE_AGENT_ADMIN_TOKEN=          # Bearer token for GET /runs and /quotes; unset = those endpoints are disabled
QUOTE_AGENT_VERIFIER_TOKEN=       # test only: enables the read-only /verifier adapter
QUOTE_AGENT_PROVIDER_HEADERS=     # test only: JSON of extra headers on every provider request
