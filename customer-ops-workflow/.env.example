# Set to 0 to call real vendor APIs (requires keys below)
CUSTOMER_OPS_USE_MOCKS=1

# Optional: DynamoDB table name (unset = in-memory local store)
# CUSTOMER_OPS_TABLE=customer-ops-workflows

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
# CUSTOMER_OPS_REQUIRE_SLACK_SIG=1

# Stripe
STRIPE_API_KEY=sk_test_...
# STRIPE_API_BASE=https://api.stripe.com

# HubSpot
HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_API_BASE=https://api.hubapi.com

# Gmail (OAuth access token with gmail.send)
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER=ops@example.com
# GMAIL_API_BASE=https://gmail.googleapis.com

# AWS Lambda / Step Functions (set by CDK)
# STATE_MACHINE_ARN=arn:aws:states:...
