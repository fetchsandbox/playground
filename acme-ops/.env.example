# Copy to .env (never commit it) and set only what your workflow needs.
# Each workflow's guide (docs/workflows/<workflow>.md, "Providers, credentials and operations")
# lists exactly which of these it uses and what must exist in the provider accounts first.

# Which workflow this runtime serves (one runtime per workflow).
WORKFLOW=support-escalation

# Provider credentials. <P>_BASE_URL is optional (defaults to the vendor's production API);
# point it at a FetchSandbox twin for verification. A provider without a key is "not configured":
# its agents are skipped and its actions recorded as skipped/not_configured — never faked.
# Each vendor's own auth scheme is used wherever the base URL points; <P>_AUTH_SCHEME=bearer is
# only for test doubles (the FetchSandbox relay runner sets it).

# --- Payments and finance
STRIPE_API_KEY=rk_test_...            # restricted key: only the resources your workflow reads/writes
# STRIPE_API_VERSION=2024-12-18.acacia # pinned by default; change only after checking the field changes
# MODERN_TREASURY_API_KEY=...
# MODERN_TREASURY_ORGANIZATION_ID=... # required with Modern Treasury (HTTP Basic: org id + key)
# PLAID_CLIENT_ID=...                 # Plaid authenticates with client id + secret in the body
# PLAID_SECRET=...
# PLAID_BASE_URL=https://sandbox.plaid.com
# NETSUITE_BASE_URL=https://<account>.suitetalk.api.netsuite.com
# NETSUITE_API_KEY=...                # OAuth 2.0 access token (expires after 60 minutes; refresh outside the runtime)
# GUSTO_API_KEY=...
# GUSTO_COMPANY_ID=...                # required with Gusto
# GUSTO_API_VERSION=2026-06-15
SQUARE_API_KEY=EAAA...                # Square access token: GIFTCARDS_WRITE, GIFTCARDS_READ, MERCHANT_PROFILE_READ

# --- CRM, support and collaboration
HUBSPOT_API_KEY=pat-...               # private app: crm.objects.contacts.read/write (+ communication preferences where used)
ZENDESK_SUBDOMAIN=acme                # or ZENDESK_BASE_URL=https://acme.zendesk.com
ZENDESK_API_KEY=...                   # OAuth token, or an API token together with ZENDESK_EMAIL
# ZENDESK_EMAIL=ops-bot@acme.example
SLACK_API_KEY=xoxb-...                # bot token: chat:write (invite it to the channels your inputs name)
# ASANA_API_KEY=...
# NOTION_API_KEY=...                  # integration token; share the database with the integration
GMAIL_API_KEY=ya29....                # OAuth access token for the ops mailbox (gmail.compose, gmail.readonly)
GOOGLE_CALENDAR_API_KEY=ya29....      # OAuth access token (calendar.events, calendar.freebusy)

# --- Identity, engineering and operations
# WORKOS_API_KEY=sk_...
# GITHUB_API_KEY=github_pat_...       # fine-grained token scoped to the repositories/orgs in your inputs
# PAGERDUTY_API_KEY=...
# PAGERDUTY_FROM_EMAIL=...            # required by PagerDuty for writes
# DATADOG_API_KEY=...
# DATADOG_APP_KEY=...
# TWILIO_API_KEY=...                  # auth token (HTTP Basic with the account SID)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_VERIFY_API_KEY=...
# TWILIO_VERIFY_SERVICE_SID=VA...

# --- Commerce, shipping, documents, screening and models
# SHOPIFY_BASE_URL=https://<shop>.myshopify.com
# SHOPIFY_API_KEY=shpat_...           # Admin API access token (sent as X-Shopify-Access-Token)
# SHOPIFY_API_VERSION=2026-01
# EASYPOST_API_KEY=...
# BOX_API_KEY=...                     # uploads go to upload.box.com automatically
# DOCUSIGN_BASE_URL=https://<your account base URI>/restapi
# DOCUSIGN_API_KEY=...
# DOCUSIGN_ACCOUNT_ID=...
# TRADE_GOV_API_KEY=...               # developer.trade.gov subscription key (Consolidated Screening List)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional
ANTHROPIC_API_KEY=                    # drafts replies/check-ins with Claude; without it, templates are used
ANTHROPIC_MODEL=claude-opus-5-5
APPROVER_USER_IDS=U012ABC,U034DEF     # default approvers when a run doesn't name any
APPROVAL_TTL_HOURS=24
STATE_FILE=.state/runs.json           # local durable state (AgentCore uses DYNAMODB_TABLE)
# TICK_INTERVAL_MS=60000              # local timer loop for workflows with reminders and deadlines
# PROVIDER_TIMEOUT_MS=15000
# PROVIDER_RETRIES=2
