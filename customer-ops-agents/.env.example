# Only needed for `npm run local -- --live-llm` (providers stay faked locally).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# In AWS these live in the Secrets Manager secret as one JSON object:
# {
#   "ANTHROPIC_API_KEY": "...",
#   "STRIPE_SECRET_KEY": "sk_test_...",
#   "HUBSPOT_TOKEN": "pat-...",              # private app: crm.objects.contacts/deals read+write, crm.objects.notes/tasks… (see README)
#   "SLACK_BOT_TOKEN": "xoxb-...",
#   "SLACK_SIGNING_SECRET": "...",
#   "GOOGLE_CLIENT_ID": "...",
#   "GOOGLE_CLIENT_SECRET": "...",
#   "GOOGLE_REFRESH_TOKEN": "...",           # scopes: gmail.send, gmail.readonly
#   "GMAIL_SENDER": "sales@yourco.com"
# }

# Optional knobs (Lambda environment, defaults shown)
MAX_AUTO_DISCOUNT_PCT=15
SURVEY_COOLDOWN_DAYS=30
RESEARCH_WEB_SEARCH=true
DEAL_STAGE_QUOTED=presentationscheduled
DEAL_STAGE_SENT=decisionmakerboughtin
